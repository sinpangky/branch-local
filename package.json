{
  "name": "branch-local",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "Branch Local",
  "homepage": "https://github.com/sinpangky",
  "description": "A local-first branching AI conversation canvas",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "web": "npm run build && node server/index.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm tar.gz --x64 --publish never",
    "release:checksums": "node scripts/release-checksums.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.branchlocal.desktop",
    "productName": "枝间",
    "copyright": "Copyright © 2026 Branch Local",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "afterPack": "build/after-pack.mjs",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appImage": {
      "executableArgs": []
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "BranchLocal",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "BranchLocal-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "shortcutName": "枝间"
    },
    "portable": {
      "artifactName": "BranchLocal-${version}-Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-",
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "artifactName": "BranchLocal-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "枝间 · Branch Local ${version}"
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "branch-local",
      "category": "Office",
      "maintainer": "Branch Local",
      "vendor": "Branch Local",
      "synopsis": "Local-first branching AI conversation canvas",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ],
      "artifactName": "BranchLocal-${version}-linux-${arch}.${ext}"
    }
  }
}
